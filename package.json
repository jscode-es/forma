{
  "name": "forma",
  "version": "0.1.0",
  "description": "Local-first AI studio to generate 3D models, rigs, animations and textures from text or reference images.",
  "private": true,
  "license": "MIT",
  "author": "JSCode",
  "repository": "github:jscode-es/forma",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n next,electron \"next dev\" \"npm run dev:electron\"",
    "dev:electron": "tsc -p electron && wait-on tcp:3000 && cross-env FORMA_DEV=1 electron .",
    "build": "next build && tsc -p electron",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p electron --noEmit"
  },
  "dependencies": {
    "@kivora/nextjs": "^0.3.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "typescript": "^6.0.3",
    "wait-on": "^9.5.1"
  }
}
