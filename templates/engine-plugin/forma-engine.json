{
  "id": "my-engine",
  "name": "My engine",
  "version": "0.1.0",
  "license": "MIT",
  "description": {
    "en": "Template engine: turns the reference image into a textured 3D card. Replace it with your model.",
    "es": "Motor de plantilla: convierte la imagen de referencia en una tarjeta 3D texturizada. Sustitúyelo por tu modelo."
  },
  "tasks": ["image-to-3d"],
  "runtime": { "type": "python", "entry": "main.py" },
  "timeoutSeconds": 600,
  "requirements": { "vramGb": 0, "cuda": false },
  "inputs": { "images": { "min": 1, "max": 1 } },
  "parameters": [
    { "id": "height", "type": "number", "label": { "en": "Height (m)", "es": "Altura (m)" }, "min": 0.1, "max": 10, "step": 0.1, "default": 1 },
    { "id": "doubleSided", "type": "boolean", "label": { "en": "Visible from both sides", "es": "Visible por ambas caras" }, "default": true }
  ],
  "weights": []
}
