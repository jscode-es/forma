{
  "id": "forma-mesh-tools",
  "name": "Forma mesh tools",
  "version": "1.0.0",
  "license": "MIT",
  "description": {
    "en": "Reduces triangles to a budget and creates levels of detail, keeping UVs and materials (meshoptimizer and glTF Transform).",
    "es": "Reduce los triángulos a un presupuesto y crea niveles de detalle conservando UV y materiales (meshoptimizer y glTF Transform)."
  },
  "tasks": ["optimize"],
  "runtime": { "type": "node", "entry": "main.cjs" },
  "timeoutSeconds": 900,
  "inputs": { "models": { "min": 1, "max": 1 } },
  "parameters": [
    { "id": "budget", "type": "integer", "label": { "en": "Triangle budget", "es": "Presupuesto de triángulos" }, "min": 128, "max": 2000000, "step": 1, "default": 10000 },
    { "id": "lod1", "type": "integer", "label": { "en": "LOD 1 triangles (0 = off)", "es": "Triángulos LOD 1 (0 = no)" }, "min": 0, "max": 2000000, "step": 1, "default": 0 },
    { "id": "lod2", "type": "integer", "label": { "en": "LOD 2 triangles (0 = off)", "es": "Triángulos LOD 2 (0 = no)" }, "min": 0, "max": 2000000, "step": 1, "default": 0 },
    { "id": "lod3", "type": "integer", "label": { "en": "LOD 3 triangles (0 = off)", "es": "Triángulos LOD 3 (0 = no)" }, "min": 0, "max": 2000000, "step": 1, "default": 0 }
  ]
}
