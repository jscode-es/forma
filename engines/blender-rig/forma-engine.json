{
  "id": "forma-blender-rig",
  "name": "Forma Blender rig",
  "version": "1.0.0",
  "license": "MIT",
  "description": {
    "en": "Local humanoid heat-weight rigging and rest-joint editing with explicit clip preservation.",
    "es": "Rig humanoide local con pesos automáticos y edición de reposo, con conservación explícita de clips."
  },
  "tasks": [
    "rig"
  ],
  "runtime": {
    "type": "blender",
    "entry": "main.py"
  },
  "timeoutSeconds": 1800,
