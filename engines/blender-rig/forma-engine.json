      "id": "mode",
      "type": "enum",
      "label": {
        "en": "Rig operation",
        "es": "Operación de rig"
      },
      "options": [
        {
          "value": "auto",
          "label": {
            "en": "Auto rig",
            "es": "Rig automático"
          }
        },
        {
          "value": "edit",
          "label": {
            "en": "Edit rest joint",
            "es": "Editar articulación de reposo"
          }
        }
      ],
      "default": "auto"
    },
    {
      "id": "clipPolicy",
      "type": "enum",
