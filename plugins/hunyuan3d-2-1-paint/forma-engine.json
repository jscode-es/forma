{
  "id": "hunyuan3d-2-1-paint",
  "name": "Hunyuan3D Paint 2.1 PBR",
  "version": "1.0.0",
  "license": "Tencent Hunyuan 3D 2.1 Community License",
  "description": {
    "en": "Textures generated and imported meshes with Tencent Hunyuan3D-Paint 2.1: albedo, metallic and roughness baked into a UV atlas, with optional Delight lighting neutralization of the reference.",
    "es": "Texturiza mallas generadas e importadas con Tencent Hunyuan3D-Paint 2.1: albedo, metalicidad y rugosidad horneadas en un atlas UV, con neutralización opcional de la iluminación de la referencia con Delight."
  },
  "tasks": [
    "texture"
  ],
  "runtime": {
    "type": "python",
    "entry": "main.py"
  },
  "timeoutSeconds": 2700,
  "requirements": {
    "vramGb": 10,
    "cuda": true
  },
  "inputs": {
    "images": {
      "min": 1,
      "max": 1
    },
    "models": {
      "min": 1,
      "max": 1
    }
  },
  "parameters": [
    {
      "id": "steps",
      "type": "integer",
      "label": {
        "en": "Steps",
        "es": "Pasos"
      },
      "min": 5,
      "max": 50,
      "step": 1,
      "default": 15
    },
    {
      "id": "guidanceScale",
      "type": "number",
      "label": {
        "en": "Guidance (CFG)",
        "es": "Guía (CFG)"
      },
      "min": 1,
      "max": 10,
      "step": 0.5,
      "default": 3
    },
    {
      "id": "atlasResolution",
      "type": "enum",
      "label": {
        "en": "Atlas resolution",
        "es": "Resolución del atlas"
      },
      "default": "1024",
      "options": [
        {
          "value": "512",
          "label": {
            "en": "512 px",
            "es": "512 px"
          }
        },
        {
          "value": "1024",
          "label": {
            "en": "1024 px",
            "es": "1024 px"
          }
        },
        {
          "value": "2048",
          "label": {
            "en": "2048 px",
            "es": "2048 px"
          }
        }
      ]
    },
    {
      "id": "faceLimit",
      "type": "integer",
      "label": {
        "en": "Face limit before painting (0 keeps all)",
        "es": "Límite de caras antes de pintar (0 conserva todas)"
      },
      "min": 0,
      "max": 200000,
      "step": 1000,
      "default": 40000
    },
    {
      "id": "removeLighting",
      "type": "boolean",
      "label": {
        "en": "Neutralize the reference lighting (Delight)",
        "es": "Neutralizar la iluminación de la referencia (Delight)"
      },
      "default": true
    },
    {
      "id": "seed",
      "type": "integer",
      "label": {
        "en": "Seed",
        "es": "Semilla"
      },
      "min": 0,
      "max": 2147483647,
      "step": 1,
      "default": 42
    }
  ],
  "weights": [
