    {
      "id": "octreeResolution",
      "type": "enum",
      "label": { "en": "Surface resolution", "es": "Resolución de superficie" },
      "default": "512",
      "options": [
        { "value": "128", "label": { "en": "128", "es": "128" } },
        { "value": "256", "label": { "en": "256", "es": "256" } },
        { "value": "380", "label": { "en": "380", "es": "380" } },
        { "value": "512", "label": { "en": "512", "es": "512" } }
      ]
    },
    { "id": "seed", "type": "integer", "label": { "en": "Seed", "es": "Semilla" }, "min": 0, "max": 2147483647, "step": 1, "default": 42 },
    { "id": "removeBackground", "type": "boolean", "label": { "en": "Remove background when the image has no transparency", "es": "Quitar el fondo si la imagen no tiene transparencia" }, "default": true }
