  },
  "tasks": ["image-to-3d", "remove-background"],
  "runtime": { "type": "python", "entry": "main.py" },
  "timeoutSeconds": 1800,
  "requirements": { "vramGb": 8, "cuda": true },
  "inputs": { "images": { "min": 1, "max": 1 } },
  "parameters": [
    { "id": "steps", "type": "integer", "label": { "en": "Steps", "es": "Pasos" }, "min": 5, "max": 100, "step": 1, "default": 30 },
