        "en": "Images",
        "es": "Imágenes"
      },
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "id": "seed",
      "type": "integer",
      "label": {
        "en": "Seed",
        "es": "Semilla"
      },
      "min": 0,
      "max": 2147483647,
      "step": 1,
      "default": 42
    },
    {
      "id": "objectFraming",
      "type": "boolean",
      "label": {
        "en": "Isolated object on a plain background",
        "es": "Objeto aislado sobre fondo liso"
      },
