{
  "id": "sdxl-lightning",
  "name": "SDXL-Lightning",
  "version": "1.3.0",
  "license": "CreativeML Open RAIL++-M",
  "description": {
    "en": "Local Qwen3 refines the object description on CPU before generating reference images in 4 steps with ByteDance SDXL-Lightning on SDXL 1.0 (fp16).",
    "es": "Qwen3 local mejora la descripción del objeto en CPU antes de generar imágenes de referencia en 4 pasos con ByteDance SDXL-Lightning sobre SDXL 1.0 (fp16)."
  },
  "tasks": [
    "text-to-image"
  ],
  "runtime": {
    "type": "python",
    "entry": "main.py"
  },
  "timeoutSeconds": 900,
  "requirements": {
    "vramGb": 8,
    "cuda": true
  },
  "parameters": [
    {
      "id": "count",
      "type": "integer",
      "label": {
        "en": "Images",
        "es": "Imágenes"
      },
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "id": "seed",
      "type": "integer",
      "label": {
        "en": "Seed",
        "es": "Semilla"
      },
      "min": 0,
      "max": 2147483647,
      "step": 1,
      "default": 42
    },
    {
      "id": "objectFraming",
      "type": "boolean",
      "label": {
        "en": "Isolated object on a plain background",
        "es": "Objeto aislado sobre fondo liso"
      },
      "default": true
    },
    {
      "id": "stylePrompt",
      "type": "string",
      "label": {
        "en": "Visual style",
        "es": "Estilo visual"
      },
      "maxLength": 2000,
      "default": ""
    }
  ],
