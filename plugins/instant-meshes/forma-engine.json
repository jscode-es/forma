{
  "id": "instant-meshes",
  "name": "Instant Meshes",
  "version": "1.0.0",
  "license": "BSD-3-Clause",
  "description": {
    "en": "CPU quad retopology with Instant Meshes and UV generation with XAtlas. Works independently of Blender. Supports static geometry with one simple material.",
    "es": "Retopología a quads en CPU con Instant Meshes y UV con XAtlas. Funciona sin Blender. Admite geometría estática con un material sencillo."
  },
  "tasks": ["retopology"],
  "runtime": { "type": "python", "entry": "main.py" },
  "timeoutSeconds": 1800,
  "requirements": { "vramGb": 0, "cuda": false, "platforms": ["win32"] },
  "inputs": { "models": { "min": 1, "max": 1 } },
  "parameters": [
    { "id": "faceBudget", "type": "integer", "label": { "en": "Quad face budget", "es": "Presupuesto de caras cuadrangulares" }, "min": 128, "max": 100000, "default": 10000 },
    { "id": "resolution", "type": "enum", "label": { "en": "Atlas resolution", "es": "Resolución del atlas" }, "default": "1024", "options": [
      { "value": "512", "label": { "en": "512", "es": "512" } },
      { "value": "1024", "label": { "en": "1024", "es": "1024" } },
      { "value": "2048", "label": { "en": "2048", "es": "2048" } },
      { "value": "4096", "label": { "en": "4096", "es": "4096" } }
    ] }
  ]
}
