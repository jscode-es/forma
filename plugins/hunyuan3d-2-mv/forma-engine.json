{
  "id": "hunyuan3d-2-mv",
  "name": "Hunyuan3D 2 MV",
  "version": "1.0.0",
  "license": "Tencent Hunyuan 3D 2.0 Community License",
  "description": {
    "en": "Multi-view image to 3D geometry with Hunyuan3D 2 MV. Accepts front, back, left and right; top views are not supported.",
    "es": "Imágenes multivista a geometría 3D con Hunyuan3D 2 MV. Acepta frontal, trasera, izquierda y derecha; no admite vista superior."
  },
  "tasks": [
    "image-to-3d",
    "remove-background"
  ],
  "runtime": {
    "type": "python",
    "entry": "main.py"
  },
  "timeoutSeconds": 1800,
  "requirements": {
    "vramGb": 8,
    "cuda": true
  },
  "inputs": {
    "images": {
      "min": 1,
      "max": 4
    },
    "views": [
      "front",
      "back",
      "left",
      "right"
    ]
  },
  "parameters": [
    {
      "id": "steps",
      "type": "integer",
      "label": {
        "en": "Steps",
        "es": "Pasos"
      },
      "min": 5,
      "max": 100,
      "step": 1,
      "default": 30
    },
    {
      "id": "guidanceScale",
      "type": "number",
      "label": {
        "en": "Guidance (CFG)",
        "es": "Guía (CFG)"
      },
      "min": 1,
      "max": 15,
      "step": 0.5,
      "default": 5
    },
    {
      "id": "octreeResolution",
      "type": "enum",
      "label": {
        "en": "Surface resolution",
        "es": "Resolución de superficie"
      },
      "default": "380",
      "options": [
        {
          "value": "256",
          "label": {
            "en": "256",
            "es": "256"
          }
        },
        {
          "value": "380",
          "label": {
            "en": "380",
            "es": "380"
          }
        },
        {
          "value": "512",
          "label": {
            "en": "512",
            "es": "512"
          }
        }
      ]
    },
    {
      "id": "seed",
      "type": "integer",
      "label": {
        "en": "Seed",
        "es": "Semilla"
      },
      "min": 0,
      "max": 2147483647,
      "step": 1,
      "default": 42
    },
    {
      "id": "removeBackground",
      "type": "boolean",
      "label": {
        "en": "Remove background when the image has no transparency",
        "es": "Quitar el fondo si la imagen no tiene transparencia"
      },
      "default": true
    }
  ],
  "weights": [
    {
      "id": "hunyuan3d-2-mv-dit",
      "name": "Hunyuan3D DiT 2 MV (fp16)",
      "license": {
        "id": "Tencent-Hunyuan-3D-2.0",
        "name": "Tencent Hunyuan 3D 2.0 Community License Agreement",
        "url": "https://github.com/Tencent-Hunyuan/Hunyuan3D-2/blob/main/LICENSE",
        "summary": {
          "en": "Does not apply in the European Union, United Kingdom or South Korea. Includes an acceptable use policy and conditions above 1 million monthly active users. Outputs are not model derivatives.",
          "es": "No se aplica en la Unión Europea, Reino Unido ni Corea del Sur. Incluye una política de uso aceptable y condiciones por encima de 1 millón de usuarios activos mensuales. Los resultados no se consideran derivados del modelo."
        }
      },
